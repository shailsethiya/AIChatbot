PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/mern-chatbot
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini
# Optional: override the OpenAI base URL (Azure OpenAI / self-hosted proxy / OpenRouter etc.)
# OPENAI_BASE_URL=
# Optional: route outbound HTTPS through a corporate proxy
# HTTPS_PROXY=http://user:pass@proxy.company.com:8080
CORS_ORIGIN=http://localhost:5173
